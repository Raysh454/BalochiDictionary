<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 Rekhta couplet of the day, set in Urdu.

  Typeface is Mehr Nastaliq Web, the same face rekhta.org serves.

  The two verse lines take their height from layout_weight rather than
  wrap_content. That matters: autosize can only shrink text against a bounded
  size, so with wrap_content the lines grew to Nastaliq's very tall natural
  metrics and pushed the poet off the bottom of the widget. Giving them a
  weighted share means the heading and the attribution are measured first and
  always fit, and the couplet scales into whatever room is left.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:contentDescription="@string/widget_verse_description">

    <TextView
        android:id="@+id/verse_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mehr_nastaliq_web"
        android:textSize="10sp"
        android:textColor="@color/widget_text_tertiary"
        android:gravity="center"
        android:textAlignment="center"
        android:textDirection="rtl"
        android:maxLines="1"
        android:text="@string/widget_verse_heading" />

    <TextView
        android:id="@+id/verse_line_one"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/mehr_nastaliq_web"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeStepGranularity="1sp"
        android:textColor="@color/widget_text_verse"
        android:gravity="center"
        android:textAlignment="center"
        android:textDirection="rtl"
        android:maxLines="1" />

    <TextView
        android:id="@+id/verse_line_two"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/mehr_nastaliq_web"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeStepGranularity="1sp"
        android:textColor="@color/widget_text_verse"
        android:gravity="center"
        android:textAlignment="center"
        android:textDirection="rtl"
        android:maxLines="1" />

    <TextView
        android:id="@+id/verse_poet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/mehr_nastaliq_web"
        android:textSize="11sp"
        android:textColor="@color/widget_text_tertiary"
        android:gravity="center"
        android:textAlignment="center"
        android:textDirection="rtl"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
