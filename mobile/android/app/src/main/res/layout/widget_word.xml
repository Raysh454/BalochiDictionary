<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2 word of the day. Tapping anywhere toggles Balochi <-> Rekhta Urdu.

  The small monospace label is kept because the two sources share the same
  script, so it is the only way to tell at a glance which one is showing.

  The headword keeps an RTL text direction, so its glyphs order correctly, but
  is aligned to the view start like everything else. Left to itself a
  right-to-left string self-aligns right, which left the word floating away
  from the label, transliteration and gloss stacked down the left edge. It
  is white like the rest of the type rather than an accent colour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:contentDescription="@string/widget_word_description">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="9sp"
        android:letterSpacing="0.18"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_label_balochi" />

    <TextView
        android:id="@+id/widget_script"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="25sp"
        android:textColor="@color/widget_text_primary"
        android:textDirection="rtl"
        android:textAlignment="viewStart"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_latin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_meaning"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="4"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="8sp"
        android:textColor="@color/widget_text_tertiary"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
