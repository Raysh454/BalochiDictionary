<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 Rekhta couplet of the day, set in Urdu.

  Deliberately unadorned: no header, no tags, nothing but the sher and its
  poet, centred with generous leading. Nastaliq slopes steeply and needs far
  more line height than a Latin face, hence the large lineSpacingExtra.

  The verse lines autosize rather than using a fixed size: a hemistich can be
  short or long, so they render as large as will fit and step down only when a
  line would otherwise be clipped.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:contentDescription="@string/widget_verse_description">

    <TextView
        android:id="@+id/verse_line_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_nastaliq_urdu"
        android:textSize="22sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeStepGranularity="1sp"
        android:lineSpacingExtra="10dp"
        android:textColor="@color/widget_text_primary"
        android:gravity="center"
        android:textAlignment="center"
        android:textDirection="rtl"
        android:maxLines="1" />

    <TextView
        android:id="@+id/verse_line_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/noto_nastaliq_urdu"
        android:textSize="22sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeStepGranularity="1sp"
        android:lineSpacingExtra="10dp"
        android:textColor="@color/widget_text_primary"
        android:gravity="center"
        android:textAlignment="center"
        android:textDirection="rtl"
        android:maxLines="1" />

    <TextView
        android:id="@+id/verse_poet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/noto_nastaliq_urdu"
        android:textSize="13sp"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/widget_text_tertiary"
        android:gravity="center"
        android:textAlignment="center"
        android:textDirection="rtl"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
