<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2 word of the day. Tapping anywhere toggles Balochi <-> Rekhta Urdu.

  The headword sits at the top and the meaning is docked to the bottom edge:
  the weighted spacer between them absorbs whatever room is left over, and
  collapses as the meaning grows upward on longer definitions.

  The spacer is a TextView rather than a View or Space because RemoteViews
  only inflates a fixed set of view classes, and plain View is not one of them.

  The small monospace label is kept because the two sources share the same
  script, so it is the only way to tell at a glance which one is showing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:contentDescription="@string/widget_word_description">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="9sp"
        android:letterSpacing="0.18"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_label_balochi" />

    <TextView
        android:id="@+id/widget_script"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="25sp"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_latin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textSize="8sp"
        android:textColor="@color/widget_text_tertiary"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Collapses to nothing once the meaning needs the room. -->
    <TextView
        android:id="@+id/widget_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp" />

    <TextView
        android:id="@+id/widget_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="5"
        android:ellipsize="end" />
</LinearLayout>
