<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2 word of the day. The whole surface is the toggle between the offline
  Balochi dictionary and Rekhta's Urdu word.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp"
    android:contentDescription="@string/widget_word_description">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="8sp"
        android:letterSpacing="0.12"
        android:textColor="@color/widget_accent"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_label_balochi" />

    <TextView
        android:id="@+id/widget_script"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="24sp"
        android:textColor="@color/widget_text_primary"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_latin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textSize="11sp"
        android:textStyle="italic"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_meaning"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/widget_text_primary"
        android:maxLines="4"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="8sp"
        android:textColor="@color/widget_text_tertiary"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
