<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2. minWidth/minHeight use the (70 * cells - 30) rule for launchers that
  predate targetCellWidth/Height. updatePeriodMillis is only a safety net; the
  provider schedules its own alarm for local midnight.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="21600000"
    android:initialLayout="@layout/widget_word"
    android:previewLayout="@layout/widget_word"
    android:description="@string/widget_word_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
